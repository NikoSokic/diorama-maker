meta {
  name: 1 Create text-to-model task
  type: http
  seq: 1
}

post {
  url: {{base}}/generation/text-to-model
  body: json
  auth: inherit
}

body:json {
  {
    "prompt": "cute stylized low-poly toy fox, full body, standing neutral pose, arms slightly away from body, single object, no base, no background, soft pastel colors",
    "model": "v3.1-20260211",
    "face_limit": 10000,
    "texture": true,
    "pbr": false,
    "texture_quality": "standard"
  }
}

script:post-response {
  bru.setVar("taskId", res.body.data.task_id);
}
