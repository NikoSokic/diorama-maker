# Copy to .env and fill in. .env is git-ignored. NEVER commit or paste real values anywhere.
# Format rules (the file is read by both Node and Spring Boot):
#   - KEY=value, no quotes, no spaces around "="
#   - comments only on their own line (no trailing "# ..." after a value)
#   - avoid backslashes in values

# --- Tripo3D (https://developers.tripo3d.ai/en/keys) ---
TRIPO_API_KEY=
# International endpoint. (China-only accounts use the developers.tripo3d.com docs instead.)
TRIPO_BASE_URL=https://openapi.tripo3d.ai/v3
# mock | live  -- keep "mock" during development; "live" spends real credits
TRIPO_MODE=mock
# Rig + retarget preset animations for bipeds/quadrupeds (costs extra credits in live mode)
ENABLE_RIGGING=true

# --- Google Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Generated narrator voice (free tier). off = the browser reads the story aloud.
# GEMINI_TTS=on
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# GEMINI_TTS_VOICE=Kore
# GEMINI_TTS_DAILY_LIMIT=150

# --- Supabase ---
# Project URL, e.g. https://abcdefghijklmnop.supabase.co
SUPABASE_URL=
# Secret key (sb_secret_...) or legacy service_role JWT. Backend only, never sent to the browser.
SUPABASE_SERVICE_KEY=
# Session pooler, as JDBC: jdbc:postgresql://aws-X-REGION.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_URL=
# Pooler username: postgres.<project-ref>
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=
# Public storage bucket for GLB files
SUPABASE_BUCKET=models

# --- App ---
MAX_STORIES_PER_IP_PER_DAY=5
# Several frontend origins may be listed, comma-separated (e.g. the production domain and localhost).
FRONTEND_ORIGIN=http://localhost:5173
# Any long random string; used to hash visitor IPs for rate limiting
IP_HASH_SALT=

# --- Optional (safe defaults; remove the leading "# " to change one) ---
# live | mock -- "mock" plans stories offline without calling Gemini
# GEMINI_MODE=live
# auto | supabase | local -- auto = Supabase only when TRIPO_MODE=live, otherwise local files in backend/data
# STORAGE_MODE=auto
# Lets GET /api/credits be called from a non-local address (send it as the X-Admin-Token header)
# ADMIN_TOKEN=
# true only behind a reverse proxy that sets X-Forwarded-For (never when the app is reachable directly)
# TRUST_PROXY=false
# How many trusted proxies sit in front of the app (the client IP is read that many entries from the right)
# TRUSTED_PROXY_HOPS=1
# true = apply the per-IP story limit to localhost too
# RATE_LIMIT_LOOPBACK=false
# Gallery thumbnails captured by the creator's player (checked by Gemini vision when Gemini is live).
# THUMBNAIL_UPLOADS=true
