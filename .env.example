# Copy to .env and fill in. .env is git-ignored. NEVER commit or paste real values anywhere.
# Format rules (the file is read by both Node and Spring Boot):
#   - KEY=value, no quotes, no spaces around "="
#   - comments only on their own line (no trailing "# ..." after a value)
#   - avoid backslashes in values

# --- Tripo3D (https://developers.tripo3d.ai/en/keys) ---
TRIPO_API_KEY=
# International endpoint. (China-only accounts use the developers.tripo3d.com docs instead.)
TRIPO_BASE_URL=https://openapi.tripo3d.ai/v3
# mock | live  -- keep "mock" during development; "live" spends real credits
TRIPO_MODE=mock
# Rig + retarget preset animations for bipeds/quadrupeds (costs extra credits in live mode)
ENABLE_RIGGING=true

# --- Google Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Supabase ---
# Project URL, e.g. https://abcdefghijklmnop.supabase.co
SUPABASE_URL=
# Secret key (sb_secret_...) or legacy service_role JWT. Backend only, never sent to the browser.
SUPABASE_SERVICE_KEY=
# Session pooler, as JDBC: jdbc:postgresql://aws-X-REGION.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_URL=
# Pooler username: postgres.<project-ref>
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=
# Public storage bucket for GLB files
SUPABASE_BUCKET=models

# --- App ---
MAX_STORIES_PER_IP_PER_DAY=5
FRONTEND_ORIGIN=http://localhost:5173
# Any long random string; used to hash visitor IPs for rate limiting
IP_HASH_SALT=
